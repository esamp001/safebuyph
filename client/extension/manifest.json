{
  "manifest_version": 3,
  "name": "SafeBuy PH Helper",
  "version": "1.0",
  "description": "Import Facebook Marketplace items to SafeBuy PH",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/marketplace/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "sb.png",
    "48": "sb.png",
    "128": "sb.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["*://*.facebook.com/*"]
    }
  ]
}
