// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String   @unique
  password         String
  phoneNumber      String?
  profilePic       String?
  isAdmin          Boolean  @default(false)
  canSell          Boolean  @default(false)
  status           String   @default("active")
  validIdUrl       String? // ID photo URL
  validIdNumber    String? // ID number
  transactionCount Int      @default(0)
  rating           Float    @default(3.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Define both sides of the relations
  buyerTransactions  Transaction[]  @relation("BuyerTransactions")
  sellerTransactions Transaction[]  @relation("SellerTransactions")
  buyerRatings       Rating[]       @relation("BuyerRating")
  sellerRatings      Rating[]       @relation("SellerRating")
  refreshTokens      RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)
}

enum TransactionStatus {
  PENDING
  ACCEPTED
  PAID
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
  TIMEOUT
}

model Transaction {
  id                       Int               @id @default(autoincrement())
  status                   TransactionStatus @default(PENDING)
  price                    Float
  buyerId                  Int
  sellerId                 Int
  amount                   Float
  escrowReleased           Boolean           @default(false)
  disputeReason            String?
  disputedAt               DateTime?
  disputeResolved          Boolean           @default(false)
  adminNote                String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  shippingProof            String? //URL of receipt or image
  shippingTrackingNumber   String? //Tracking number from courier
  paymentProof             String? //URL of payment receipt
  paymentTransactionNumber String? //Reference number from payment
  deliveryConfirmed        Boolean           @default(false)
  shippedAt                DateTime?
  deliveryConfirmedAt      DateTime?
  paidAt                   DateTime? // When the transaction was paid
  shippingDeadline         DateTime? // When the shipping should happen by
  receivedAt               DateTime? // When the item was received
  autoReleased             Boolean           @default(false) // Whether escrow was auto-released
  autoConfirmationDeadline DateTime? // Deadline for auto-confirmation
  statusUpdatedAt          DateTime          @default(now()) // Track when status changes
  timeoutAt                DateTime? // When the current status will timeout

  buyer  User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller User    @relation("SellerTransactions", fields: [sellerId], references: [id])
  // Add relation for ratings
  rating Rating?
}

model Rating {
  id            Int      @id @default(autoincrement())
  transactionId Int      @unique
  buyerId       Int
  sellerId      Int
  score         Int
  comment       String?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  buyer       User        @relation("BuyerRating", fields: [buyerId], references: [id])
  seller      User        @relation("SellerRating", fields: [sellerId], references: [id])
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
