generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int            @id @default(autoincrement())
  name               String
  email              String         @unique
  createdAt          DateTime       @default(now())
  password           String
  phoneNumber        String?
  profilePic         String?
  rating             Float          @default(3.0)
  status             String         @default("active")
  transactionCount   Int            @default(0)
  updatedAt          DateTime       @updatedAt
  canSell            Boolean        @default(false)
  isAdmin            Boolean        @default(false)
  validIdNumber      String?
  validIdUrl         String?
  bio                String?
  buyerRatings       Rating[]       @relation("BuyerRating")
  sellerRatings      Rating[]       @relation("SellerRating")
  refreshTokens      RefreshToken[]
  buyerTransactions  Transaction[]  @relation("BuyerTransactions")
  sellerTransactions Transaction[]  @relation("SellerTransactions")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id                       Int               @id @default(autoincrement())
  buyerId                  Int
  sellerId                 Int
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  disputeReason            String?
  escrowReleased           Boolean           @default(false)
  price                    Float
  status                   TransactionStatus @default(PENDING)
  amount                   Float
  adminNote                String?
  disputeResolved          Boolean           @default(false)
  disputedAt               DateTime?
  shippingTrackingNumber   String?
  deliveryConfirmed        Boolean           @default(false)
  deliveryConfirmedAt      DateTime?
  paidAt                   DateTime?
  shippedAt                DateTime?
  shippingDeadline         DateTime?
  shippingProof            String?
  paymentProof             String?
  paymentTransactionNumber String?
  autoConfirmationDeadline DateTime?
  autoReleased             Boolean           @default(false)
  receivedAt               DateTime?
  statusUpdatedAt          DateTime          @default(now())
  timeoutAt                DateTime?
  rating                   Rating?
  buyer                    User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller                   User              @relation("SellerTransactions", fields: [sellerId], references: [id])
}

model Rating {
  id            Int         @id @default(autoincrement())
  transactionId Int         @unique
  buyerId       Int
  sellerId      Int
  score         Int
  comment       String?
  createdAt     DateTime    @default(now())
  buyer         User        @relation("BuyerRating", fields: [buyerId], references: [id])
  seller        User        @relation("SellerRating", fields: [sellerId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

enum TransactionStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
  ACCEPTED
  TIMEOUT
}
